# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000

# Comma-separated list of sites allowed to call the API from the browser.
CORS_ORIGINS=http://localhost:8080,https://chefsdelightsfoods.com

# Razorpay → Dashboard → Account & Settings → API Keys.
# Use rzp_test_… keys while developing; switch to rzp_live_… in production.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Optional. Razorpay → Webhooks → secret you set there. Enables /api/webhooks/razorpay.
RAZORPAY_WEBHOOK_SECRET=

# Sent as the x-admin-key header to create/update/delete products and list orders.
# Use a long random string, e.g. `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`
ADMIN_API_KEY=change-me-to-a-long-random-string

# SQLite file. Created automatically.
DATABASE_PATH=./data/store.db
